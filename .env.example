# Copy this to a real .env file on the VPS (in the same directory as
# compose.prod.yml) — docker compose loads .env automatically. Never commit
# the real .env file.

# Postgres (used by both the `db` and `web`/`migrate` services below)
POSTGRES_USER=midpoint
POSTGRES_PASSWORD=change-me-to-a-long-random-value
POSTGRES_DB=midpoint
DATABASE_URL=postgresql://midpoint:change-me-to-a-long-random-value@db:5432/midpoint

# Session signing secret for admin login (generate with: openssl rand -hex 32)
AUTH_SECRET=change-me-to-a-long-random-value

# Existing site env vars (unchanged)
NEXT_PUBLIC_ALLOW_INDEXING=true
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
VACANCY_REVALIDATE_SECONDS=604800

# Used once by prisma/seed.ts to create the first SUPER_ADMIN account.
# Safe to remove from .env after the first successful deploy.
SEED_SUPERADMIN_EMAIL=brettd@blendproperty.co.za
SEED_SUPERADMIN_PASSWORD=set-a-temporary-password-here
