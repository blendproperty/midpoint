generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  EDITOR
}

enum ContentStatus {
  DRAFT
  PUBLISHED
}

enum Sector {
  WAREHOUSE
  OFFICE
  SERVICED_OFFICE
}

enum VacancyEventType {
  VIEW
  ENQUIRE
}

enum ContactStatus {
  NEW
  CONTACTED
  QUALIFIED
  WON
  LOST
}

model User {
  id                  String                @id @default(cuid())
  email               String                @unique
  passwordHash        String
  name                String?
  role                Role                  @default(EDITOR)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  blogPosts           BlogPost[]
  assignedContacts    Contact[]
  contactNotes        ContactNote[]
  passwordResetTokens PasswordResetToken[]
}

model BlogPost {
  id             String        @id @default(cuid())
  slug           String        @unique
  title          String
  excerpt        String?
  contentHtml    String        @db.Text
  coverImage     String?
  status         ContentStatus @default(DRAFT)
  seoTitle       String?
  seoDescription String?
  focusKeyword   String?
  ogTitle        String?
  ogDescription  String?       @db.Text
  ogImage        String?
  noIndex        Boolean       @default(false)
  canonicalUrl   String?
  schemaJson     Json?
  headCode       String?       @db.Text
  bodyCode       String?       @db.Text
  publishedAt    DateTime?
  authorId       String?
  author         User?         @relation(fields: [authorId], references: [id], onDelete: SetNull)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model Page {
  id                 String        @id @default(cuid())
  slug               String        @unique
  title              String
  contentHtml        String        @db.Text
  status             ContentStatus @default(DRAFT)
  passwordProtected  Boolean       @default(false)
  accessPasswordHash String?
  seoTitle           String?
  seoDescription     String?
  focusKeyword       String?
  ogTitle            String?
  ogDescription      String?       @db.Text
  ogImage            String?
  noIndex            Boolean       @default(false)
  canonicalUrl       String?
  schemaJson         Json?
  headCode           String?       @db.Text
  bodyCode           String?       @db.Text
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
}

model PillarPage {
  id                   String        @id @default(cuid())
  slug                 String        @unique
  title                String
  primaryEntity        String?
  primaryAudience      String?
  decisionStage        String?
  primarySearchIntent  String?
  primaryConversion    String?
  heroAnswer           String?       @db.Text
  heroImage            String?
  trustStrip           String?       @db.Text
  contentHtml          String        @db.Text
  faqs                 Json?
  faqsHeading          String?
  features             Json?
  considerations       Json?
  relatedSector        Sector?
  listingsHeading      String?
  listingsIntro        String?       @db.Text
  showReadyToMove      Boolean       @default(false)
  ctaHeading           String?
  ctaText              String?       @db.Text
  exploreLinks         Json?
  expertName           String?
  expertRole           String?
  expertBio            String?       @db.Text
  expertImage          String?
  reviewOwner          String?
  lastReviewedAt       DateTime?
  nextReviewAt         DateTime?
  status               ContentStatus @default(DRAFT)
  passwordProtected    Boolean       @default(false)
  accessPasswordHash   String?
  seoTitle             String?
  seoDescription       String?
  focusKeyword         String?
  ogTitle              String?
  ogDescription        String?       @db.Text
  ogImage              String?
  noIndex              Boolean       @default(false)
  canonicalUrl         String?
  schemaJson           Json?
  headCode             String?       @db.Text
  bodyCode             String?       @db.Text
  publishedAt          DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
}

model Vacancy {
  id           String        @id @default(cuid())
  building     String
  // Optional specific unit/suite name within a shared building — needed for
  // buildings like OnPoint where many individual listings all share the same
  // `building` value ("OnPoint") but are actually different physical units.
  // Populated by the listings.blendproperty.co.za sync from the listing's
  // own `name` field when it differs from the building/park name; editable
  // by hand too so an enquiry can always be tied back to the exact space a
  // visitor clicked on rather than just the shared building name.
  unitName     String?
  sector       Sector
  sizeSqm      Float
  ratePerSqm   Float
  availability String
  description  String        @db.Text
  features     String[]
  image        String?
  status       ContentStatus @default(PUBLISHED)
  sortOrder    Int           @default(0)
  // Set only on rows created/updated by the listings.blendproperty.co.za
  // sync (lib/listings-sync.ts) — the external listing's `id`, so repeated
  // syncs upsert the same row instead of duplicating it. Manually-created
  // vacancies (added directly in /admin) are left with externalId = null
  // and the sync never touches them.
  externalId   String?       @unique
  lastSyncedAt DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Faq {
  id        String   @id @default(cuid())
  question  String
  answer    String   @db.Text
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SiteSetting {
  id                       String   @id @default("global")
  siteName                 String   @default("Midpoint Midrand")
  domain                   String   @default("https://www.mid-point.co.za")
  phone                    String   @default("+27 11 380 9400")
  email                    String   @default("boitumelo@blendproperty.co.za")
  defaultSocialImage       String?
  googleVerification       String?
  bingVerification         String?
  allowIndexing            Boolean  @default(true)
  vacancyRevalidateSeconds Int      @default(604800)
  recaptchaSiteKey         String?
  googleAnalyticsId        String?
  tagManagerId             String?
  defaultTitleTemplate     String?
  defaultMetaDescription   String?
  defaultKeywords          String?
  whatsapp                 String?
  whatsappTemplate         String?
  enquirySuccessMessage    String?
  // Full VacancySyncResult (see lib/listings-sync.ts) from the most recent
  // sync run, whether triggered by the "Sync now" button or the VPS cron
  // job — lets /admin/vacancies show exactly which listings had an
  // unrecognised sector/status (with the real raw string from their API),
  // not just a bare count, without needing a dedicated log table.
  lastVacancySync          Json?
  updatedAt                DateTime @updatedAt
}

// `alt` is required (non-empty enforced in the upload actions/API route, not
// just here) — every image uploaded through the Media library must carry
// alt text from the moment it's added, instead of relying on the SEO scorer
// to catch missing alt attributes after the fact in published content.
model Media {
  id           String   @id @default(cuid())
  filename     String
  url          String
  mimeType     String
  size         Int
  alt          String   @default("")
  uploadedById String?
  createdAt    DateTime @default(now())
}

// One person, deduplicated by email. Every Enquiry that comes in (from the
// contact form or the /api/leads endpoint) is upserted against this table so
// repeat submissions roll up into one record with a full history, instead
// of piling up as disconnected rows in Enquiry.
model Contact {
  id           String        @id @default(cuid())
  firstName    String?
  lastName     String?
  email        String        @unique
  phone        String?
  status       ContactStatus @default(NEW)
  source       String?
  assignedToId String?
  assignedTo   User?         @relation(fields: [assignedToId], references: [id], onDelete: SetNull)
  enquiries    Enquiry[]
  notes        ContactNote[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model ContactNote {
  id        String   @id @default(cuid())
  contactId String
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  authorId  String?
  author    User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  body      String   @db.Text
  createdAt DateTime @default(now())
}

// Tokenized, single-use, time-limited (1 hour) password reset links. Only
// the SHA-256 hash of the token is stored — the raw token only ever exists
// in the emailed link and briefly in memory server-side.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model Enquiry {
  id         String   @id @default(cuid())
  firstName  String?
  lastName   String?
  email      String
  phone      String?
  interest   String?
  message    String?  @db.Text
  sourcePath String?
  handled    Boolean  @default(false)
  contactId  String?
  contact    Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())
}

model PageView {
  id        String   @id @default(cuid())
  path      String
  createdAt DateTime @default(now())
}

model VacancyEvent {
  id        String           @id @default(cuid())
  vacancyId String?
  building  String?
  type      VacancyEventType
  createdAt DateTime         @default(now())
}

model PageSeoOverride {
  path           String   @id
  seoTitle       String?
  seoDescription String?
  ogTitle        String?
  ogDescription  String?  @db.Text
  ogImage        String?
  noIndex        Boolean  @default(false)
  canonicalUrl   String?
  schemaJson     Json?
  headCode       String?  @db.Text
  bodyCode       String?  @db.Text
  updatedAt      DateTime @updatedAt
}

// URL redirects (e.g. old Webflow slugs -> new equivalents, or any changed
// path) enforced in middleware.ts. hitCount/lastHitAt let an editor tell a
// dead rule from one that's still catching real traffic before deleting it.
model Redirect {
  id         String    @id @default(cuid())
  fromPath   String    @unique
  toPath     String
  statusCode Int       @default(301)
  hitCount   Int       @default(0)
  lastHitAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}
